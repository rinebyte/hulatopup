# ====== Branding ======
# Semua nilai NEXT_PUBLIC_* dibaca saat build. Setelah mengubah, restart `npm run dev`
# atau jalankan ulang `npm run build`.

# Nama brand yang tampil di seluruh situs
NEXT_PUBLIC_BRAND_NAME=HULATOPUP
# Variasi penulisan brand untuk SEO, dipisah koma (cara orang mungkin mengetik nama brand)
NEXT_PUBLIC_BRAND_ALIASES=Hula Topup,Hula Top Up
# Kalimat singkat di bawah logo / hero
NEXT_PUBLIC_BRAND_TAGLINE=Topup game online cepat, murah & terpercaya
# URL publik situs (WAJIB diisi domain asli saat production: canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ====== SEO ======
# Kode verifikasi Google Search Console (isi content dari meta tag "google-site-verification")
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ====== Kontak ======
# Nomor WhatsApp format internasional tanpa "+" (contoh: 6281234567890)
NEXT_PUBLIC_WHATSAPP=6281234567890
NEXT_PUBLIC_SUPPORT_EMAIL=support@hulatopup.test
NEXT_PUBLIC_INSTAGRAM=hulatopup
